# macOS
.DS_Store

# Local only files
/.local/

# Build and packaging output (make build / make package / make zip)
/build/
/dist/

# Dependencies fetched by `make deps`; the pinned checksums in deps/SHA256SUMS are tracked
/deps/*
!/deps/SHA256SUMS

# The emulator builds in-tree; keep its output out of git
/ti99sim/bin/
/ti99sim/src/*/Release/
/ti99sim/src/*/Debug/
*.o
*.a
*.so
*.so.*
*.dep

# TI ROMs, cartridges and disk images are copyrighted: never commit them
*.ctg
# Upstream ships a CF7+ firmware image (cf7a+.bin) in roms/; it is third-party and not needed here
/ti99sim/roms/*.bin

# Local run output
*.log

# Track upstream modifications patch even if global ignore excludes *.patch
!/upstream-modifications.patch
