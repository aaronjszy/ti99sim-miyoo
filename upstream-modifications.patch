+RETRO_API void retro_set_environment( retro_environment_t cb )
+{
+	g_EnvironCb = cb;
+	if( cb == nullptr )
+	{
+		return;
+	}
+
+	bool noGame = true;
+	cb( RETRO_ENVIRONMENT_SET_SUPPORT_NO_GAME, &noGame );
+
+	libretro_set_core_options( cb );
