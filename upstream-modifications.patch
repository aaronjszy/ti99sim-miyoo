+bool cRetroTMS9918A::ParseState( const sStateSection &state )
+{
+	if( cTMS9918A::ParseState( state ) == true )
+	{
+		RebuildPalette( );
+		MarkAllDirty( );
+		return true;
+	}
+
+	return false;
+}
