+//
+//----------------------------------------------------------------------------
+
+#ifndef TMS9918A_RETRO_HPP_
+#define TMS9918A_RETRO_HPP_
+
+#include <cstdint>
+#include "tms9918a.hpp"
+
+#define RETRO_VDP_BORDER_X      16
+#define RETRO_VDP_BORDER_Y      12
+#define RETRO_VDP_BORDER_WIDTH  ( VDP_WIDTH + 2 * RETRO_VDP_BORDER_X )
+#define RETRO_VDP_BORDER_HEIGHT ( VDP_HEIGHT + 2 * RETRO_VDP_BORDER_Y )
+
+enum class eRetroPalette
+{
+	DEFAULT = 0,
+	NTSC    = 1,
+	RGB     = 2,
+	MONO    = 3
+};
+
+class cRetroTMS9918A :
+	public cTMS9918A
+{
+	friend class cRetroTI994A;
+
+	uint32_t        m_ColorTable8888[ 17 ];
+	uint16_t        m_ColorTable565 [ 17 ];
+	eRetroPalette   m_Palette;
+	bool            m_ShowBorders;
+	bool            m_UseRGB565;
+
+	bool            m_TextMode;
+	bool            m_ChangesMade;
+	bool            m_BlankChanged;
+	bool            m_ColorsChanged;
+	bool            m_SpritesChanged;
+
+	bool            m_ScreenChanged[ 0x03C0 ];
+	bool            m_PatternChanged[ 256 * 3 ];
+	int             m_CharUse[ 256 * 3 ];
+	int             m_SpriteCharUse[ 256 ];
+
+	UINT8           m_CharacterPattern[ 3 * 256 ][ 8 * 8 ];
+	UINT8           m_BitmapScreen[ VDP_WIDTH * VDP_HEIGHT ];
+	UINT8           m_BitmapSpriteScreen[ VDP_WIDTH * VDP_HEIGHT ];
+	const UINT8    *m_ScreenSource;
+
+	uint16_t        m_FrameBuffer565 [ RETRO_VDP_BORDER_WIDTH * RETRO_VDP_BORDER_HEIGHT ];
+	uint32_t        m_FrameBuffer8888[ RETRO_VDP_BORDER_WIDTH * RETRO_VDP_BORDER_HEIGHT ];
+
+public:
+
+	cRetroTMS9918A( int refreshRate = 60 );
+
+	// iStateObject methods
+	virtual bool ParseState( const sStateSection &state ) override;
+
+	// iTMS9918A methods
+	virtual void Reset( ) override;
+	virtual void WriteData( UINT8 data ) override;
+	virtual void WriteRegister( size_t reg, UINT8 value ) override;
+	virtual bool Retrace( ) override;
+	virtual void Render( ) override;
+
+	void SetPalette( eRetroPalette palette );
+	eRetroPalette GetPalette( ) const { return m_Palette; }
+
+	void SetShowBorders( bool show );
+	bool GetShowBorders( ) const { return m_ShowBorders; }
+
+	void SetUseRGB565( bool rgb565 );
+	bool GetUseRGB565( ) const { return m_UseRGB565; }
+
+	void SetRefreshRate( int refreshRate );
+
+	unsigned GetOutputWidth( ) const  { return m_ShowBorders ? RETRO_VDP_BORDER_WIDTH  : VDP_WIDTH; }
+	unsigned GetOutputHeight( ) const { return m_ShowBorders ? RETRO_VDP_BORDER_HEIGHT : VDP_HEIGHT; }
+	size_t   GetOutputPitch( ) const  { return GetOutputWidth( ) * ( m_UseRGB565 ? sizeof( uint16_t ) : sizeof( uint32_t )); }
+
+	const void *GetFrameBuffer( ) const { return m_UseRGB565 ? static_cast<const void *>( m_FrameBuffer565 ) : static_cast<const void *>( m_FrameBuffer8888 ); }
+	uint16_t *GetFrameBuffer565( )  { return m_FrameBuffer565; }
+	uint32_t *GetFrameBuffer8888( ) { return m_FrameBuffer8888; }
+
+	void MarkAllDirty( );
+
+protected:
+
+	void RebuildPalette( );
+	void ComposeFrameBuffer( );
+
+	void DrawSprite( int index );
+	const UINT8 *UpdateSprites( );
+
+	void UpdateCharacterPatternGraphics( int ch, UINT8 fore, UINT8 back, UINT8 *pattern );
+	void UpdateCharacterPatternBitMap( int ch, UINT8 *pattern );
+
+	void UpdateScreenGraphics( int x, int y, int ch );
+	void UpdateScreenText( int x, int y, int ch );
+	void UpdateScreenMultiColor( int x, int y, int ch );
+
+	int ScreenSize( ) const      { return m_TextMode ? 24 * 40 : 24 * 32; }
+	int GetCellWidth( ) const    { return m_TextMode ? 6 : 8; }
+	int GetScreenWidth( ) const  { return m_TextMode ? 40 : 32; }
+	int GetScreenHeight( ) const { return 24; }
+
+	void MarkScreenChanges( int ch );
+
+	bool RefreshInvalid( );
+	bool RefreshGraphics( );
+	bool RefreshBitMap( );
+	bool RefreshMultiColor( );
+
+	void UpdateScreen( );
+
+	// cTMS9918A protected methods
+	virtual bool SetMode( int mode ) override;
+	virtual void FlipAddressing( ) override;
+
+	virtual ~cRetroTMS9918A( ) override;
+
+private:
+
+	cRetroTMS9918A( const cRetroTMS9918A & ) = delete;
+	void operator =( const cRetroTMS9918A & ) = delete;
+};
+
+#endif
diff -ruN a/ti99sim/src/libretro/tms9919-retro.cpp b/ti99sim/src/libretro/tms9919-retro.cpp
--- a/ti99sim/src/libretro/tms9919-retro.cpp	1969-12-31 17:00:00
+++ b/ti99sim/src/libretro/tms9919-retro.cpp	2026-10-31 23:35:19
@@ -0,0 +1,288 @@
+//----------------------------------------------------------------------------
+//
+// File:        tms9919-retro.cpp
+// Date:        31-Oct-2026
+// Programmer:  Aaron Szymanski
+//
+// Description: Libretro synchronous PSG + TMS5220 audio synthesizer
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+//----------------------------------------------------------------------------
+
+#include <algorithm>
+#include <cstring>
+#include "common.hpp"
+#include "logger.hpp"
+#include "itms9900.hpp"
+#include "itms5220.hpp"
+#include "tms9919-retro.hpp"
+
+DBG_REGISTER( __FILE__ );
+
+#define NOISE_RESET              0x00F35
+#define NOISE_WHITE_GENERATOR    0x12000
+#define NOISE_PERIODIC_GENERATOR 0x08000
+#define CLOCK_FREQUENCY          3579545
+
+cRetroTMS9919::cRetroTMS9919( int sampleFreq ) :
+	cBaseObject( "cRetroTMS9919" ),
+	m_SampleRate( sampleFreq ),
+	m_MasterVolume( 75 ),
+	m_PsgVolume( 100 ),
+	m_SpeechVolume( 100 ),
+	m_VolumeTable( ),
+	m_Info( ),
+	m_ShiftRegister( NOISE_RESET ),
+	m_NoiseGenerator( NOISE_WHITE_GENERATOR ),
+	m_pCPU( nullptr ),
+	m_FrameStartClocks( 0 ),
+	m_FrameTotalClocks( 50000 ),
+	m_FrameTargetSamples( 735 ),
+	m_RenderedSamples( 0 ),
+	m_MonoBuffer( )
+{
+	float volume = 32768.0f / 4.0f;
+	for( unsigned int i = 0; i < SIZE( m_VolumeTable ) - 1; i++ )
+	{
+		m_VolumeTable[ i ] = static_cast<int>( volume );
+		volume = volume / 1.258925412f; // Reduce volume by 2dB per step
+	}
+	m_VolumeTable[ 15 ] = 0;
+
+	uint8_t color = m_NoiseColor;
+	uint8_t type  = m_NoiseType;
+	m_NoiseColor  = static_cast<uint8_t>( -1 );
+	m_NoiseType   = static_cast<uint8_t>( -1 );
+	SetNoise( color, type );
+}
+
+cRetroTMS9919::~cRetroTMS9919( )
+{
+}
+
+int cRetroTMS9919::GetPlaybackFrequency( )
+{
+	return m_SampleRate;
+}
+
+void cRetroTMS9919::SetMasterVolume( int volume )
+{
+	m_MasterVolume = std::clamp( volume, 0, 100 );
+}
+
+void cRetroTMS9919::SetPsgVolume( int volume )
+{
+	m_PsgVolume = std::clamp( volume, 0, 100 );
+}
+
+void cRetroTMS9919::SetSpeechVolume( int volume )
+{
+	m_SpeechVolume = std::clamp( volume, 0, 200 );
+}
+
+void cRetroTMS9919::BeginFrame( uint32_t startClocks, uint32_t totalClocks, int targetSamples )
+{
+	m_FrameStartClocks   = startClocks;
+	m_FrameTotalClocks   = ( totalClocks > 0 ) ? totalClocks : 50000;
+	m_FrameTargetSamples = std::clamp( targetSamples, 1, static_cast<int>( SIZE( m_MonoBuffer )));
+	m_RenderedSamples    = 0;
+}
+
+void cRetroTMS9919::CatchUpToClocks( uint32_t currentClocks )
+{
+	uint32_t elapsed = currentClocks - m_FrameStartClocks;
+	if( static_cast<int32_t>( elapsed ) <= 0 )
+	{
+		return;
+	}
+
+	int targetSample = static_cast<int>(( static_cast<uint64_t>( elapsed ) * m_FrameTargetSamples ) / m_FrameTotalClocks );
+	targetSample = std::clamp( targetSample, m_RenderedSamples, m_FrameTargetSamples );
+
+	int count = targetSample - m_RenderedSamples;
+	if( count > 0 )
+	{
+		RenderSamples( m_MonoBuffer + m_RenderedSamples, count );
+		m_RenderedSamples = targetSample;
+	}
+}
+
+size_t cRetroTMS9919::EndFrame( int16_t *stereoOut )
+{
+	int remaining = m_FrameTargetSamples - m_RenderedSamples;
+	if( remaining > 0 )
+	{
+		RenderSamples( m_MonoBuffer + m_RenderedSamples, remaining );
+		m_RenderedSamples = m_FrameTargetSamples;
+	}
+
+	for( int i = 0; i < m_FrameTargetSamples; i++ )
+	{
+		int32_t sample = ( static_cast<int32_t>( m_MonoBuffer[ i ] ) * m_MasterVolume ) / 100;
+		int16_t clamped = static_cast<int16_t>( std::clamp( sample, -32768, 32767 ));
+		stereoOut[ i * 2 + 0 ] = clamped;
+		stereoOut[ i * 2 + 1 ] = clamped;
+	}
+
+	return static_cast<size_t>( m_FrameTargetSamples );
+}
+
+void cRetroTMS9919::WriteData( UINT8 data )
+{
+	if( m_pCPU != nullptr )
+	{
+		CatchUpToClocks( m_pCPU->GetClocks( ));
+	}
+
+	cTMS9919::WriteData( data );
+}
+
+void cRetroTMS9919::RenderSamples( INT16 *dst, int samples )
+{
+	if( samples <= 0 )
+	{
+		return;
+	}
+
+	memset( dst, 0, sizeof( INT16 ) * samples );
+
+	for( int i = 0; i < 4; i++ )
+	{
+		sVoiceInfo *info = &m_Info[ i ];
+		if(( m_Attenuation[ i ] != 15 ) && ( info->period >= 1.0f ))
+		{
+			int left = samples;
+			int j = 0;
+			do
+			{
+				int count = ( info->toggle < left ) ? static_cast<int>( info->toggle ) : left;
+				left -= count;
+				info->toggle -= count;
+				while( count-- )
+				{
+					dst[ j++ ] += static_cast<INT16>( info->setting );
+				}
+				if( info->toggle < 1.0f )
+				{
+					info->toggle += info->period;
+					if( i < 3 )
+					{
+						info->setting = -info->setting;
+					}
+					else
+					{
+						if( m_ShiftRegister & 1 )
+						{
+							m_ShiftRegister ^= m_NoiseGenerator;
+							if( m_ShiftRegister == 0 )
+							{
+								m_ShiftRegister = NOISE_RESET;
+							}
+							info->setting = -info->setting;
+						}
+						m_ShiftRegister >>= 1;
+					}
+				}
+			}
+			while( left > 0 );
+		}
+	}
+
+	// Apply PSG volume scaling
+	if( m_PsgVolume != 100 )
+	{
+		for( int i = 0; i < samples; i++ )
+		{
+			dst[ i ] = static_cast<INT16>(( static_cast<int32_t>( dst[ i ] ) * m_PsgVolume ) / 100 );
+		}
+	}
+
+	// Mix Speech synthesizer with speech volume scaling
+	if( m_pSpeechSynthesizer != nullptr )
+	{
+		INT16 speechBuf[ 1024 ];
+		int chunk = std::min( samples, 1024 );
+		memset( speechBuf, 0, sizeof( INT16 ) * chunk );
+
+		if( m_pSpeechSynthesizer->AudioCallback( speechBuf, chunk ))
+		{
+			for( int i = 0; i < chunk; i++ )
+			{
+				int32_t mixed = dst[ i ] + (( static_cast<int32_t>( speechBuf[ i ] ) * m_SpeechVolume ) / 100 );
+				dst[ i ] = static_cast<INT16>( std::clamp( mixed, -32768, 32767 ));
+			}
+		}
+	}
+}
+
+void cRetroTMS9919::SetNoise( uint8_t color, uint8_t type )
+{
+	bool reset = ( color != m_NoiseColor );
+
+	cTMS9919::SetNoise( color, type );
+
+	if( reset )
+	{
+		m_ShiftRegister = NOISE_RESET;
+	}
+	m_NoiseGenerator = ( color == NOISE_WHITE ) ? NOISE_WHITE_GENERATOR : NOISE_PERIODIC_GENERATOR;
+
+	sVoiceInfo *info = &m_Info[ 3 ];
+
+	if( m_Frequency[ 3 ] != 0 )
+	{
+		int volume    = m_VolumeTable[ m_Attenuation[ 3 ] & 0x0F ];
+		info->period  = static_cast<float>( m_SampleRate ) / ( CLOCK_FREQUENCY / static_cast<float>( m_Frequency[ 3 ] )) / 2.0f;
+		info->setting = ( info->setting > 0 ) ? volume : -volume;
+	}
+	else
+	{
+		info->period = 0.0f;
+	}
+}
+
+void cRetroTMS9919::SetFrequency( uint8_t tone, uint16_t freq )
+{
+	cTMS9919::SetFrequency( tone, freq );
+
+	if( tone < 3 )
+	{
+		sVoiceInfo *info = &m_Info[ tone ];
+
+		if(( freq < m_SampleRate / 2 ) && ( freq != 0 ))
+		{
+			int volume    = m_VolumeTable[ m_Attenuation[ tone ] & 0x0F ];
+			info->period  = static_cast<float>( m_SampleRate ) / ( CLOCK_FREQUENCY / static_cast<float>( freq )) / 2.0f;
+			info->setting = ( info->setting > 0 ) ? volume : -volume;
+		}
+		else
+		{
+			info->period  = 512.0f;
+			info->setting = 0;
+		}
+	}
+}
+
+void cRetroTMS9919::SetAttenuation( uint8_t tone, uint8_t atten )
+{
+	cTMS9919::SetAttenuation( tone, atten );
+
+	if( tone < 4 )
+	{
+		sVoiceInfo *info = &m_Info[ tone ];
+		int volume    = m_VolumeTable[ m_Attenuation[ tone ] & 0x0F ];
+		info->setting = ( info->setting > 0 ) ? volume : -volume;
+	}
+}
+
+void cRetroTMS9919::RefreshVoices( )
+{
+	for( uint8_t i = 0; i < 3; i++ )
+	{
+		SetFrequency( i, m_Frequency[ i ] );
+		SetAttenuation( i, m_Attenuation[ i ] );
+	}
+	SetNoise( m_NoiseColor, m_NoiseType );
+	SetAttenuation( 3, m_Attenuation[ 3 ] );
+}
