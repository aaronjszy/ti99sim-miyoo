+//----------------------------------------------------------------------------
+//
+// File:        ti994a-retro.hpp
+// Date:        31-Oct-2026
+// Programmer:  Aaron Szymanski
+//
+// Description: Libretro TI-99/4A machine coordinator and binary serialization
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+//----------------------------------------------------------------------------
+
+#ifndef TI994A_RETRO_HPP_
+#define TI994A_RETRO_HPP_
+
+#include <cstddef>
+#include <cstdint>
+#include "ti994a.hpp"
+#include "tms9918a-retro.hpp"
+#include "tms9919-retro.hpp"
+
+class cRetroTI994A :
+	public cTI994A
+{
+	cRetroTMS9918A     *m_RetroVDP;
+	cRetroTMS9919      *m_RetroSound;
+	bool                m_Enable32K;
+	bool                m_SpeechEnabled;
+	int                 m_RefreshRate;
+	UINT8              *m_Fallback32K[ 16 ];
+
+public:
+
+	cRetroTI994A( iCartridge *console, cRetroTMS9918A *vdp, cRetroTMS9919 *sound, iTMS5220 *speech, bool enable32K = true );
+	virtual ~cRetroTI994A( ) override;
+
+	void RunFrame( int16_t *audioOut, size_t *audioFramesOut );
+
+	void SetRefreshRate( int hz );
+	int  GetRefreshRate( ) const { return m_RefreshRate; }
+
+	void Set32KExpansion( bool enable );
+	bool Get32KExpansion( ) const { return m_Enable32K; }
+
+	void SetSpeechEnabled( bool enable );
+	bool GetSpeechEnabled( ) const { return m_SpeechEnabled; }
+
+	void SetAlphaLockFix( bool enable );
+
+	iTMS9901       *GetPIC( ) const        { return m_PIC; }
+	cRetroTMS9918A *GetRetroVDP( ) const   { return m_RetroVDP; }
+	cRetroTMS9919  *GetRetroSound( ) const { return m_RetroSound; }
+	iCartridge     *GetCartridge( ) const  { return m_Cartridge; }
+
+	// RetroArch memory descriptors
+	void  *GetSaveRAMPtr( ) const;
+	size_t GetSaveRAMSize( ) const;
+	void  *GetScratchpadPtr( )  { return m_Scratchpad; }
+	size_t GetScratchpadSize( ) const { return sizeof( m_Scratchpad ); }
+
+	// Fast deterministic binary savestates
+	size_t SerializeSize( ) const;
+	bool   Serialize( void *data, size_t size ) const;
+	bool   Unserialize( const void *data, size_t size );
+
+	// iComputer overrides
+	virtual void Reset( ) override;
+	virtual bool Sleep( int cycles, UINT32 timeout ) override;
+	virtual bool WakeCPU( UINT32 timeout ) override;
+
+protected:
+
+	virtual void TimerHookProc( UINT32 clockCycles ) override;
+	virtual UINT8 SpeechWriteBreakPoint( ADDRESS address, UINT8 data ) override;
+	virtual UINT8 SpeechReadBreakPoint( ADDRESS address, UINT8 data ) override;
+
+	void EnsureConsole32KBanks( );
+
+private:
+
+	cRetroTI994A( const cRetroTI994A & ) = delete;
+	cRetroTI994A &operator =( const cRetroTI994A & ) = delete;
+};
+
+#endif
diff -ruN a/ti99sim/src/libretro/tms9918a-retro.cpp b/ti99sim/src/libretro/tms9918a-retro.cpp
--- a/ti99sim/src/libretro/tms9918a-retro.cpp	1969-12-31 17:00:00
+++ b/ti99sim/src/libretro/tms9918a-retro.cpp	2026-10-31 23:35:19
@@ -0,0 +1,1065 @@
+//----------------------------------------------------------------------------
+//
+// File:        tms9918a-retro.cpp
+// Date:        31-Oct-2026
+// Programmer:  Aaron Szymanski
+//
+// Description: Libretro software VDP renderer for the TMS9918A
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+//----------------------------------------------------------------------------
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include "common.hpp"
+#include "logger.hpp"
+#include "tms9918a-retro.hpp"
+
+DBG_REGISTER( __FILE__ );
+
+namespace
+{
+	struct sPaletteRGB
+	{
+		uint8_t r;
+		uint8_t g;
+		uint8_t b;
+	};
+
+	constexpr sPaletteRGB BasePalettes[ 3 ][ 17 ] =
+	{
+		// Palette 0: Default
+		{
+			{ 0x00, 0x00, 0x00 }, // 0x00 TI_TRANSPARENT - Background
+			{ 0x00, 0x00, 0x00 }, // 0x01 TI_BLACK
+			{ 0x48, 0x9C, 0x08 }, // 0x02 TI_MEDIUM_GREEN
+			{ 0x70, 0xBF, 0x88 }, // 0x03 TI_LIGHT_GREEN
+			{ 0x28, 0x3C, 0x8A }, // 0x04 TI_DARK_BLUE
+			{ 0x50, 0x6C, 0xCF }, // 0x05 TI_LIGHT_BLUE
+			{ 0xD0, 0x48, 0x00 }, // 0x06 TI_DARK_RED
+			{ 0x00, 0xCC, 0xFF }, // 0x07 TI_CYAN
+			{ 0xD0, 0x58, 0x28 }, // 0x08 TI_MEDIUM_RED
+			{ 0xFF, 0xA0, 0x40 }, // 0x09 TI_LIGHT_RED
+			{ 0xFC, 0xF0, 0x50 }, // 0x0A TI_DARK_YELLOW
+			{ 0xFF, 0xFF, 0x80 }, // 0x0B TI_LIGHT_YELLOW
+			{ 0x00, 0x80, 0x00 }, // 0x0C TI_DARK_GREEN
+			{ 0xCD, 0x58, 0xCD }, // 0x0D TI_MAGENTA
+			{ 0xE0, 0xE0, 0xE0 }, // 0x0E TI_GRAY
+			{ 0xFF, 0xFF, 0xFF }, // 0x0F TI_WHITE
+			{ 0xFF, 0xFF, 0xFF }  // 0x10 Text Mode Foreground
+		},
+		// Palette 1: NTSC
+		{
+			{ 0x00, 0x00, 0x00 }, // 0x00 TI_TRANSPARENT - Background
+			{ 0x00, 0x00, 0x00 }, // 0x01 TI_BLACK
+			{   33,  200,   66 }, // 0x02 TI_MEDIUM_GREEN
+			{   94,  220,  120 }, // 0x03 TI_LIGHT_GREEN
+			{   84,   85,  237 }, // 0x04 TI_DARK_BLUE
+			{  125,  118,  252 }, // 0x05 TI_LIGHT_BLUE
+			{  212,   82,   77 }, // 0x06 TI_DARK_RED
+			{   66,  235,  245 }, // 0x07 TI_CYAN
+			{  252,   85,   84 }, // 0x08 TI_MEDIUM_RED
+			{  255,  121,  120 }, // 0x09 TI_LIGHT_RED
+			{  212,  193,   84 }, // 0x0A TI_DARK_YELLOW
+			{  230,  206,  128 }, // 0x0B TI_LIGHT_YELLOW
+			{   33,  176,   59 }, // 0x0C TI_DARK_GREEN
+			{  201,   91,  186 }, // 0x0D TI_MAGENTA
+			{  204,  204,  204 }, // 0x0E TI_GRAY
+			{ 0xFF, 0xFF, 0xFF }, // 0x0F TI_WHITE
+			{ 0xFF, 0xFF, 0xFF }  // 0x10 Text Mode Foreground
+		},
+		// Palette 2: RGB
+		{
+			{ 0x00, 0x00, 0x00 }, // 0x00 TI_TRANSPARENT - Background
+			{ 0x00, 0x00, 0x00 }, // 0x01 TI_BLACK
+			{ 0x00, 0xCC, 0x00 }, // 0x02 TI_MEDIUM_GREEN
+			{ 0x00, 0xFF, 0x00 }, // 0x03 TI_LIGHT_GREEN
+			{ 0x00, 0x00, 0x80 }, // 0x04 TI_DARK_BLUE
+			{ 0x00, 0x00, 0xFF }, // 0x05 TI_LIGHT_BLUE
+			{ 0x80, 0x00, 0x00 }, // 0x06 TI_DARK_RED
+			{ 0x00, 0xFF, 0xFF }, // 0x07 TI_CYAN
+			{ 0xCC, 0x00, 0x00 }, // 0x08 TI_MEDIUM_RED
+			{ 0xFF, 0x00, 0x00 }, // 0x09 TI_LIGHT_RED
+			{ 0xB0, 0xB0, 0x00 }, // 0x0A TI_DARK_YELLOW
+			{ 0xFF, 0xFF, 0x00 }, // 0x0B TI_LIGHT_YELLOW
+			{ 0x00, 0x80, 0x00 }, // 0x0C TI_DARK_GREEN
+			{ 0xB0, 0x00, 0xB0 }, // 0x0D TI_MAGENTA
+			{ 0xCC, 0xCC, 0xCC }, // 0x0E TI_GRAY
+			{ 0xFF, 0xFF, 0xFF }, // 0x0F TI_WHITE
+			{ 0xFF, 0xFF, 0xFF }  // 0x10 Text Mode Foreground
+		}
+	};
+
+	inline uint16_t PackRGB565( uint8_t r, uint8_t g, uint8_t b )
+	{
+		return static_cast<uint16_t>((( r >> 3 ) << 11 ) | (( g >> 2 ) << 5 ) | ( b >> 3 ));
+	}
+
+	inline uint32_t PackXRGB8888( uint8_t r, uint8_t g, uint8_t b )
+	{
+		return ( static_cast<uint32_t>( r ) << 16 ) | ( static_cast<uint32_t>( g ) << 8 ) | static_cast<uint32_t>( b );
+	}
+}
