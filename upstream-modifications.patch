+				Reset( );
+			}
+			break;
+		case sKeyAction::SAVE :
+			if( down )
+			{
+				SaveCurrentState( );
+			}
+			break;
+		case sKeyAction::LOAD :
+			if( down )
+			{
+				LoadCurrentState( );
+			}
+			break;
+		case sKeyAction::KEYS :
+			if( action.key1 == VK_NONE )
+			{
+				break;
+			}
+			if( down )
+			{
+				pic->VKeysDown( scancode, action.key1, action.key2 );
+			}
+			else
+			{
+				pic->VKeyUp( scancode );
+			}
+			break;
+	}
+}
