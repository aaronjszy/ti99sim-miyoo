+
+void cSdlTI994A::ApplyKeyAction( const sKeyAction &action, int scancode, bool down )
+{
+	iTMS9901 *pic = m_PIC;
+
+	switch( action.type )
+	{
+		case sKeyAction::FIRE :
+			pic->SetJoystickButton( 0, down );
+			break;
+		case sKeyAction::RESET :
+			if( down )
+			{
+				Reset( );
+			}
+			break;
+		case sKeyAction::KEYS :
+			if( action.key1 == VK_NONE )
+			{
+				break;
+			}
+			if( down )
+			{
+				pic->VKeysDown( scancode, action.key1, action.key2 );
+			}
+			else
+			{
+				pic->VKeyUp( scancode );
+			}
+			break;
 	}
 }
 
